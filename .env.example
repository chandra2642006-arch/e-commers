# =======================================================
# Order Exception Control Tower — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.
# =======================================================

# Flask
FLASK_SECRET_KEY=change-this-to-a-long-random-string
FLASK_DEBUG=false
FLASK_PORT=5000

# MySQL
DB_HOST=db
DB_PORT=3306
DB_NAME=order_exception_control_tower
DB_USER=oect_user
DB_PASSWORD=change-this-db-password
MYSQL_ROOT_PASSWORD=change-this-root-password

# Webhook authentication (must match n8n env var)
WEBHOOK_SECRET=webhook-secret-change-in-prod

# Admin API key for privileged endpoints
ADMIN_API_KEY=admin-key-change-in-prod

# n8n URL — used by backend to trigger automation
# From Docker Compose: use container name
# From host machine: use localhost:5678
N8N_WEBHOOK_URL=http://host.docker.internal:5678/webhook/order-event

# Test DB (only used by automated tests)
TEST_DB_NAME=order_exception_control_tower_test

# Twilio WhatsApp Configuration (Sandbox)
# Enter your Twilio credentials from console.twilio.com
TWILIO_ACCOUNT_SID=your-twilio-account-sid-placeholder
TWILIO_AUTH_TOKEN=your-twilio-auth-token-placeholder
TWILIO_WHATSAPP_NUMBER=+14155238886
